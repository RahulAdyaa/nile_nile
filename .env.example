# ─── Core Django Settings ─────────────────────────────────────
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (pick ONE, uncomment it) ────────────────────────
# SQLite — zero setup, works instantly:
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL — uncomment below and comment out SQLite above:
# DATABASE_URL=postgres://your_username:your_password@localhost:5432/nile_db

# ─── AI Analytics (optional — "Ask Your Data" feature) ───────
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── OAuth Social Login (optional) ───────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=
